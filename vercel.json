{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/sobremesas-de-travessa/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sobremesas-de-travessa/:path*",
      "destination": "/sobremesas-de-travessa/index.html"
    }
  ]
}
